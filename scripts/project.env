# Project settings shared by the release scripts (sourced by scripts/common.sh).
# This is the single place to change them. Variables already set in the environment win.

# Official builds: Developer ID team and notarytool keychain profile.
# The bundle identifier (io.github.tommasoseita.dimail, in src-tauri/tauri.conf.json) and the team
# must never change: macOS ties Keychain access to them.
TEAM_ID=UGKAG4UL9P
NOTARY_PROFILE=divoice-notary

# Public repository that hosts the releases and the updater's latest.json.
GITHUB_REPO=tommasoseita/diMail

# Private key that signs updates (minisign, made with `npx tauri signer generate`). Its public key
# is in src-tauri/tauri.conf.json. Never commit it; keep a copy in a password manager.
UPDATER_KEY=~/.tauri/dimail-updater.key
